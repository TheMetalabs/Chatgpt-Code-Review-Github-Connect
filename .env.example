# Copy to .env and fill locally. Never commit .env.

# Tunnel hostname only (no https://). Used for Vite allowedHosts + webhook URL hint.
ASHLAR_PUBLIC_HOST=
# Extra hosts, comma-separated. Optional; defaults to PUBLIC_HOST.
ASHLAR_ALLOWED_HOSTS=

# GitHub App — optional if saved in Settings (stored in gitignored .data/)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Local OpenAI-compatible LLM (optional; also saved under .data/ashlar-bot-settings.json)
ASHLAR_REVIEW_LOCAL=true
ASHLAR_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
ASHLAR_LOCAL_LLM_API_KEY=
ASHLAR_LOCAL_LLM_MODEL=Qwen3.8-27B-oQ4e-mtp
