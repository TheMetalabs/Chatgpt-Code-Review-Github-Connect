# Copy to .env and fill locally. Never commit .env.
# Settings → Save also writes these keys on this machine.

# Tunnel hostname only (no https://). Used for Vite allowedHosts + webhook URL hint.
ASHLAR_PUBLIC_HOST=
# Extra hosts, comma-separated. Optional; defaults to PUBLIC_HOST.
ASHLAR_ALLOWED_HOSTS=

# Reviewers / local LLM. Settings → Save writes these on this machine.
# OpenAI-compatible server, e.g. http://127.0.0.1:8000/v1
ASHLAR_REVIEW_CHATGPT=
ASHLAR_REVIEW_GROK=
ASHLAR_REVIEW_LOCAL=
ASHLAR_LOCAL_LLM_BASE_URL=
ASHLAR_LOCAL_LLM_MODEL=
ASHLAR_LOCAL_LLM_API_KEY=
# Local leg hard wall-clock ceiling in ms. Empty/0 = none (a queued multi-turn review can take hours).
ASHLAR_LOCAL_REVIEW_DEADLINE_MS=
# Abort a streaming local leg after this many ms of TOTAL silence (no headers/keepalive/token). Reset
# by any sign of life; the server keepalives ~every 10s, so a queue never trips it. Empty=10min, 0=off.
ASHLAR_LOCAL_REVIEW_LIVENESS_MS=
# Abort a local leg that has SENT HTTP but produced no output token for this many ms, even if
# keepalives keep arriving (a ghost occupancy of a concurrency-1 server). Empty=30min, 0=off.
# Waiting for Ashlar's FIFO lease is not counted; the timer starts at dispatch. Buffered (non-SSE)
# response headers are keepalives, not output — the timer stays armed until the full body arrives.
ASHLAR_LOCAL_REVIEW_QUEUED_MS=
# Optional: serialize chat/completions HTTP (capacity 1) so the next lease-holder cannot send while
# a cancelled request is still occupying the server. "true" to enable; off by default.
ASHLAR_LOCAL_SLOT_LOCK=
# SSE streaming for chat/completions (token heartbeat → queued vs generating). "false" = plain JSON.
ASHLAR_LOCAL_LLM_STREAM=
ASHLAR_REVIEW_ORDER=
ASHLAR_CHATGPT_REASONING=
ASHLAR_GROK_REASONING=

# Chrome MV3 bridge token. Written on first boot; Rotate in Settings replaces it. Do not commit.
ASHLAR_BRIDGE_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Private operational archive (one server writer on a persistent POSIX volume).
ASHLAR_HISTORY_DIR=.data/review-history
# Separate read token; must be >=32 characters. Never use a VITE_ prefix.
ASHLAR_HISTORY_TOKEN=

# Formatting-only fallback; false disables new/in-flight candidate application.
ASHLAR_LOCAL_JSON_REPAIR_ENABLED=true
# Send chat_template_kwargs {enable_thinking:false} with each repair request (vLLM/omlx).
# On by default (a formatting-only repair needs no thinking; it shares the local model with reviews).
# Set false to opt out, e.g. for a server that strictly follows the OpenAI schema and rejects the field.
ASHLAR_LOCAL_REPAIR_NO_THINKING=true
# Maximum wall-clock time for one repair's model request/retries after it gets the shared lease.
# Default 10 minutes; a non-positive or invalid value falls back to the safety default.
ASHLAR_LOCAL_REPAIR_DEADLINE_MS=
# Local JSON repairs a local review lends the model to at each turn boundary (short lane). Default 2;
# 0 = never lend (a repair then waits for the review holding the model to finish).
ASHLAR_LOCAL_SHORT_JOBS_PER_CHECKPOINT=
# Concurrent holders of the process-wide local-model lease (reviews, fixes, JSON repairs). Default 1,
# clamped 1–8. Match the model server, e.g. oMLX concurrent=3. Settings → local_llm.lease_capacity.
ASHLAR_LOCAL_LEASE_CAPACITY=
